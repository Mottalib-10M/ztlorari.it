---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/is-the-ztl-active-now/" title="Embed the “Is the ZTL active now?” tool on your website" width="100%" height="820" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the “Is the ZTL active now?” tool on your website" description="Embed free the tool that tells visitors whether an Italian ZTL is active now, with hours, source and date: one iframe code to copy, no sign-up and no cookies on your site." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the tool</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up and no cost. Hotels, holiday lets and associations install it in a minute for their guests.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: the link below the tool stays visible, the tool is not altered and is provided without warranty. When we correct a timetable, your page shows the correction with no work on your side. Italian version: <code>{`${SITE_URL}/embed/ztl-attiva-adesso/`}</code>.</p>
    <p>Your visitors’ choices stay in their browser: nothing goes through our servers and the embedded frame sets no cookies on your site. For any request use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/is-the-ztl-active-now/" title="Embed the “Is the ZTL active now?” tool on your website" width="100%" height="820" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
